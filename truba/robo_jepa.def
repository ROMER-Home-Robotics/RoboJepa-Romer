REQS

    uv pip install --python "$PY" \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        --index-strategy unsafe-best-match \
        -r /opt/robo_jepa-requirements.txt

    # torchcodec (a lerobot dependency) resolves to the cu128 index's build, which
    # needs NVIDIA NPP (libnppicc.so.12) and fails to load without it. robo_jepa
    # does not import it; the PyPI build only needs the system FFmpeg.
    uv pip install --python "$PY" --reinstall --no-deps \
        --index-url https://pypi.org/simple torchcodec==0.5

    # cosmos-tokenizer hard-pins einops/mediapy/einx/ipdb: install it without
    # its dependencies (the runtime ones are pinned above), as environment.yml says.
    uv pip install --python "$PY" --no-deps \
        "git+https://github.com/NVIDIA/Cosmos-Tokenizer.git@3584ae752ce8ebdbe06a420bf60d7513c0e878cc"

    # -------------------------------------------------------------------------
    # 5. V-JEPA 2.1 code for torch.hub (source="local" via VJEPA2_HUB_REPO)
    # -------------------------------------------------------------------------
    VJEPA2_COMMIT=204698b45b3712590f06245fbfba32d3be539812
    git clone https://github.com/facebookresearch/vjepa2.git /opt/vjepa2
    git -C /opt/vjepa2 checkout "$VJEPA2_COMMIT"
    rm -rf /opt/vjepa2/.git

    # -------------------------------------------------------------------------
    # 6. Lockfile, cleanup, world-readable (multi-user HPC)
    # -------------------------------------------------------------------------
    uv pip freeze --python "$PY" > /opt/robo_jepa-requirements.lock
    rm -rf /tmp/uv-cache /root/.cache
    chmod -R a+rX /opt/python /opt/robo_jepa /opt/vjepa2 \
        /opt/robo_jepa-requirements.txt /opt/robo_jepa-requirements.lock

%test
    export PATH=/opt/robo_jepa/bin:$PATH
    export PYTHONNOUSERSITE=1
    export VJEPA2_HUB_REPO=/opt/vjepa2
    python - <<'PYTEST'
import sys

import numpy, torch, torchvision, xformers, timm, einops, h5py, pandas, scipy, yaml, wandb, submitit
import av, decord, torchcodec, cv2, PIL, psutil, fsspec, filelock, lerobot, mujoco
import cosmos_tokenizer  # noqa: F401
import os
assert os.path.isfile(os.path.join(os.environ["VJEPA2_HUB_REPO"], "hubconf.py"))

print(f"python        {sys.version.split()[0]}")
print(f"numpy         {numpy.__version__}")
print(f"torch         {torch.__version__}  (cuda build: {torch.version.cuda})")
print(f"torchvision   {torchvision.__version__}")
print(f"xformers      {xformers.__version__}")
print(f"timm          {timm.__version__}")
print(f"av / decord   {av.__version__} / {decord.__version__}")
# Compiled kernels must cover H100/H200 (sm_90) and Blackwell (sm_120); get_arch_list() is empty without a GPU.
arch = torch.cuda.get_arch_list()
print(f"torch archs   {arch or '(no GPU visible)'}")
assert not arch or {"sm_90", "sm_120"} <= set(arch), arch
print(f"torch.cuda.is_available() -> {torch.cuda.is_available()} (False at build time is expected)")
print("OK")
PYTEST

%runscript
    exec "$@"
