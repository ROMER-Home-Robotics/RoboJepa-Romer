Bootstrap: docker
From: ubuntu:22.04

# =============================================================================
#  robo_jepa training container (TRUBA kolyoz H100/H200, local RTX PRO 6000)
#  - Python 3.11 (uv-managed), venv at /opt/robo_jepa
#  - PyTorch 2.7.1 + cu128: kernels for Hopper (sm_90) and Blackwell (sm_120)
#    in one image. Needs NVIDIA driver >= 570.
#  - The pip pins of environment.yml, except:
#      * torch / torchvision / triton / xformers and the nvidia-* libraries are
#        the cu128 builds (the env pins cu126, which has no sm_120 kernels);
#      * robocasa / robosuite are left out (RoboCasa planning evals only; they
#        also need the ~23 GB kitchen asset download).
#  - cosmos-tokenizer from git with --no-deps (see environment.yml).
#  - The public V-JEPA 2.1 code at /opt/vjepa2 (VJEPA2_HUB_REPO): the encoder
#    is built with torch.hub, which otherwise downloads it from GitHub and
#    compute nodes have no internet.
#
#  The robo_jepa repository is NOT baked in: bind it and run from its root.
#
#  Build:  apptainer build --fakeroot robo_jepa.sif truba/robo_jepa.def
#  Run:    apptainer exec --nv --bind /arf:/arf --pwd $REPO robo_jepa.sif \
#              python -m app.main --fname <config> --devices cuda:0
# =============================================================================

%labels
    Maintainer  yyesilnur
    Application robo_jepa
    Python      3.11
    PyTorch     2.7.1+cu128
    VJEPA2      204698b45b3712590f06245fbfba32d3be539812

%help
    Container for robo_jepa world-model training / finetuning.

      REPO=/arf/home/$USER/Workspace/wm/RoboJepa-Romer

      # sanity check
      apptainer exec --nv robo_jepa.sif python -c "import torch; print(torch.cuda.is_available())"

      # training (run from the repository root; see truba/robo_jepa_train.slurm)
      apptainer exec --nv --bind /arf:/arf --pwd $REPO robo_jepa.sif \
          python -m app.main --fname configs/finetuning/arena_100m_truba.yaml --devices cuda:0

    Notes:
      * PYTHONNOUSERSITE=1 keeps the host's ~/.local site-packages out.
      * VJEPA2_HUB_REPO=/opt/vjepa2 makes torch.hub load the encoder code
        from the image instead of GitHub.

%environment
    export VIRTUAL_ENV=/opt/robo_jepa
    export PATH=/opt/robo_jepa/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1

    export VJEPA2_HUB_REPO=/opt/vjepa2
    export TOKENIZERS_PARALLELISM=false
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
    export MKL_THREADING_LAYER=GNU
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl
    export HF_HUB_DISABLE_TELEMETRY=1

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # -------------------------------------------------------------------------
    # 1. OS-level dependencies
    #    build-essential + linux-libc-dev: evdev (a pynput dependency) and
    #    triton's launcher stubs compile at install / run time.
    #    ffmpeg: torchcodec loads the system FFmpeg libraries.
    #    libgl1/libegl1/libglib2.0-0: OpenCV, PyOpenGL.
    # -------------------------------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget git git-lfs xz-utils unzip \
        build-essential pkg-config linux-libc-dev \
        ffmpeg libgl1 libegl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
        tzdata less vim-tiny
    rm -rf /var/lib/apt/lists/*
    git lfs install --system || true

    # -------------------------------------------------------------------------
    # 2. uv (pinned) from the GitHub release tarball
    # -------------------------------------------------------------------------
    UV_VERSION=0.12.2
    curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
        -o /tmp/uv.tar.gz
    tar -xzf /tmp/uv.tar.gz -C /tmp
    install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv  /usr/local/bin/uv
    install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uvx /usr/local/bin/uvx
    rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu
    uv --version

    export UV_LINK_MODE=copy
    export UV_HTTP_TIMEOUT=600
    export UV_CACHE_DIR=/tmp/uv-cache
    export UV_COMPILE_BYTECODE=1
    export UV_PYTHON_INSTALL_DIR=/opt/python

    # -------------------------------------------------------------------------
    # 3. Python 3.11 (uv-managed, kept inside the image) and the venv
    # -------------------------------------------------------------------------
    uv python install 3.11
    uv venv --python 3.11 --python-preference only-managed /opt/robo_jepa
    export VIRTUAL_ENV=/opt/robo_jepa
    PY=/opt/robo_jepa/bin/python

    # -------------------------------------------------------------------------
    # 4. Requirements, resolved in ONE uv pass (pins from environment.yml)
    # -------------------------------------------------------------------------
    cat > /opt/robo_jepa-requirements.txt <<'REQS'
# --- deep learning stack (CUDA 12.8 wheels; environment.yml pins cu126) -----
torch==2.7.1+cu128
torchvision==0.22.1+cu128
triton==3.3.1
xformers==0.0.31.post1
# environment.yml takes evdev from conda-forge (pynput needs it on Linux)
evdev==2.0.0

# --- environment.yml pip pins ----------------------------------------------
absl-py==2.5.0
aiohappyeyeballs==2.7.1
aiohttp==3.14.3
aiosignal==1.4.0
annotated-types==0.8.0
